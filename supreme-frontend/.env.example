# ===============================
# SUPREME Frontend Environment
# ===============================

# Backend base URL (FastAPI)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Set true to log API request/response details in browser console
VITE_DEBUG_API=false

# Set true to log voice provider diagnostics in browser console
VITE_DEBUG_VOICE=false

# Vapi voice layer — public key + per-role voice IDs
# Keep your private Vapi key in backend .env only.
VITE_VAPI_PUBLIC_KEY=
VITE_VAPI_VOICE_PROVIDER=11labs
VITE_VAPI_MODEL_PROVIDER=openai
VITE_VAPI_MODEL=gpt-4o-mini
VITE_VAPI_PROSECUTOR_VOICE=
VITE_VAPI_DEFENSE_VOICE=
VITE_VAPI_JUDGE_VOICE=
