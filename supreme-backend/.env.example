# ── OpenRouter (REQUIRED) ─────────────────────────────────────────────────────
# Get free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here

# ── OpenAI embeddings (OPTIONAL) ─────────────────────────────────────────────
OPENAI_API_KEY=

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_URL=https://your-cluster-id.us-east-1-1.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=ecourt_precedents

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://default:********@ideal-grouse-87619.upstash.io:6379

# ── Vapi (OPTIONAL voice layer) ───────────────────────────────────────────────
VAPI_API_KEY=your_vapi_key_here
VAPI_PROSECUTOR_VOICE=
VAPI_DEFENSE_VOICE=
VAPI_JUDGE_VOICE=

# ── Demo / App ────────────────────────────────────────────────────────────────
DEMO_MODE=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
ENABLE_RAG_DEBUG=false
EXPOSE_DEBUG_TRACES=false
DEBUG_API_TOKEN=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
