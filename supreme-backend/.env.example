# ==============================
# SUPREME Backend Environment
# ==============================

# -- LLM (required) --
OPENROUTER_API_KEY=

# -- Embeddings (optional but recommended for semantic RAG) --
EMBEDDING_PROVIDER=nvidia
EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
OPENAI_API_KEY=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# -- Qdrant (required for semantic RAG) --
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=ecourt_precedents_nv1024
QDRANT_VECTOR_SIZE=1024

# -- Session store --
# sqlite | redis | memory
SESSION_BACKEND=sqlite
SESSION_SQLITE_PATH=./data/sessions.db
SESSION_TTL=86400

# Optional: only needed if SESSION_BACKEND=redis
# REDIS_URL=rediss://default:<password>@<host>:6379

# -- Vapi voice layer (optional) --
VAPI_API_KEY=
VAPI_PROSECUTOR_VOICE=
VAPI_DEFENSE_VOICE=
VAPI_JUDGE_VOICE=

# -- Indian Kanoon API (for dataset fetch script) --
INDIANKANOON_API_TOKEN=

# -- App runtime --
DEMO_MODE=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
ENABLE_RAG_DEBUG=false

# Frontend dev origins allowed to call backend
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
